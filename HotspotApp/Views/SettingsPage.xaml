<views:ViewModelPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:HotspotApp.Views" x:Class="HotspotApp.Views.SettingsPage">
  <views:ViewModelPage.Resources>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="CardHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SupportingText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </views:ViewModelPage.Resources>
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Compact"/>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1050"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SecondaryColumn.Width" Value="*"/>
            <Setter Target="NetworkCard.(Grid.Row)" Value="0"/>
            <Setter Target="NetworkCard.(Grid.Column)" Value="1"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Uid="SettingsDesign_Title" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock x:Uid="SettingsDesign_Subtitle" Style="{StaticResource SupportingText}"/>
      </StackPanel>
      <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="1300" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
                <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Uid="SettingsDesign_Control" Style="{StaticResource CardHeading}"/>
                <TextBlock x:Uid="SettingsDesign_ControlDescription" Style="{StaticResource SupportingText}"/>
              </StackPanel>
            </Grid>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="14">
              <TextBlock Text="{x:Bind ViewModel.TestStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ManualTestStatus"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ToggleHotspot"
                      Content="{x:Bind ViewModel.HotspotButtonLabel, Mode=OneWay}"
                      Background="{x:Bind ViewModel.HotspotButtonBackground, Mode=OneWay}"
                      IsEnabled="{x:Bind ViewModel.CanToggleHotspot, Mode=OneWay}"
                      Command="{x:Bind ViewModel.ToggleHotspotCommand}"/>
              <Button x:Uid="SettingsPage_RefreshTest" AutomationProperties.AutomationId="RefreshManualTest" Command="{x:Bind ViewModel.RefreshTestCommand}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SupportingText}" x:Uid="SettingsPage_ManualTestDescription" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Grid ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SecondaryColumn" Width="0"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource SettingsCard}" VerticalAlignment="Top">
            <StackPanel Spacing="18">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
                  <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock x:Uid="SettingsDesign_Connections" Style="{StaticResource CardHeading}"/>
                  <TextBlock x:Uid="SettingsDesign_ConnectionsDescription" Style="{StaticResource SupportingText}"/>
                </StackPanel>
              </Grid>
              <ComboBox x:Uid="SettingsPage_Upstream" AutomationProperties.AutomationId="UpstreamSelector" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.UpstreamOptions}" SelectedItem="{x:Bind ViewModel.SelectedUpstream, Mode=TwoWay}" DisplayMemberPath="Label"/>
              <ComboBox x:Uid="SettingsPage_Target" AutomationProperties.AutomationId="TargetSelector" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.TargetOptions}" SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}" DisplayMemberPath="Label"/>
              <Button x:Uid="SettingsPage_RefreshAdapters" AutomationProperties.AutomationId="RefreshAdapters" Command="{x:Bind ViewModel.RefreshAdaptersCommand}"/>
              <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel Spacing="6">
                  <TextBlock x:Uid="SettingsDesign_Legend" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource SupportingText}" x:Uid="SettingsPage_AdapterLegend" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border x:Name="NetworkCard" Grid.Row="1" Style="{StaticResource SettingsCard}" VerticalAlignment="Top">
            <StackPanel Spacing="16">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
                  <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock x:Uid="SettingsDesign_Network" Style="{StaticResource CardHeading}"/>
                  <TextBlock x:Uid="SettingsDesign_NetworkDescription" Style="{StaticResource SupportingText}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="SettingsPage_SsidHeader" Text="{x:Bind ViewModel.Ssid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Uid="SettingsPage_CopySsid" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.CopySsidCommand}"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Uid="SettingsPage_PasswordHeader" Margin="0,0,0,8" Grid.ColumnSpan="2"/>
                <PasswordBox x:Name="HiddenPassword" x:Uid="SettingsPage_PasswordBox" Grid.Row="1" Password="{x:Bind ViewModel.Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordRevealMode="Hidden"/>
                <TextBox x:Name="VisiblePassword" Grid.Row="1" Visibility="Collapsed"
                         AutomationProperties.AutomationId="VisiblePassword"
                         Text="{x:Bind ViewModel.Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button x:Uid="SettingsPage_PasswordGenerate" Command="{x:Bind ViewModel.GeneratePasswordCommand}"/>
                  <ToggleButton x:Name="ShowPasswordButton" x:Uid="SettingsPage_ShowPassword" AutomationProperties.AutomationId="ShowPassword" Click="ShowPassword_Click"/>
                </StackPanel>
              </Grid>
              <ComboBox x:Uid="SettingsPage_SecurityHeader" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.AuthenticationOptions}" SelectedItem="{x:Bind ViewModel.SelectedAuthentication, Mode=TwoWay}" DisplayMemberPath="Label"/>
              <ComboBox x:Uid="SettingsPage_BandHeader" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.BandOptions}" SelectedItem="{x:Bind ViewModel.SelectedBand, Mode=TwoWay}" DisplayMemberPath="Label"/>
              <ComboBox x:Uid="SettingsPage_Channel" AutomationProperties.AutomationId="ChannelSelector"
                DropDownClosed="Channel_DropDownClosed"
                HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ChannelOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}" DisplayMemberPath="Label" />
            <TextBlock x:Uid="SettingsPage_ChannelDescription" Style="{StaticResource SupportingText}" />
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel Spacing="6">
                <CheckBox x:Uid="SettingsPage_CustomDns" AutomationProperties.AutomationId="UseCustomDns"
                    IsChecked="{x:Bind ViewModel.UseCustomDns, Mode=TwoWay}" />
                <TextBlock x:Uid="SettingsPage_CustomDnsDescription" Style="{StaticResource SupportingText}" />
                <ComboBox x:Uid="SettingsPage_DnsMode" AutomationProperties.AutomationId="DnsMode"
                    Visibility="{x:Bind ViewModel.DnsOptionsVisibility, Mode=OneWay}" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.DnsModeOptions}" DisplayMemberPath="Label"
                    SelectedItem="{x:Bind ViewModel.SelectedDnsMode, Mode=TwoWay}" />
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ManualDnsVisibility, Mode=OneWay}">
                  <TextBox x:Uid="SettingsPage_PreferredDns" AutomationProperties.AutomationId="PreferredDns"
                      PlaceholderText="8.8.8.8" Text="{x:Bind ViewModel.PreferredDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox x:Uid="SettingsPage_AlternateDns" AutomationProperties.AutomationId="AlternateDns"
                      PlaceholderText="1.1.1.1" Text="{x:Bind ViewModel.AlternateDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <NumberBox x:Uid="SettingsPage_DeviceLimitHeader" HorizontalAlignment="Stretch" Minimum="1" Maximum="32" SmallChange="1" LargeChange="2" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.MaxClientCount, Mode=TwoWay}"/>
              <Button x:Uid="SettingsPage_ShowQr" Command="{x:Bind ViewModel.ShowQrCodeCommand}" IsEnabled="{x:Bind ViewModel.EnableService, Mode=OneWay}"/>
            </StackPanel>
          </Border>
        </Grid>
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
                <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Uid="SettingsDesign_Preferences" Style="{StaticResource CardHeading}"/>
                <TextBlock x:Uid="SettingsDesign_PreferencesDescription" Style="{StaticResource SupportingText}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="16" Padding="4">
            <StackPanel Spacing="8">
              <ComboBox x:Uid="SettingsPage_Language" AutomationProperties.AutomationId="LanguageSelector" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.LanguageOptions}" SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" DisplayMemberPath="Label"/>
              <TextBlock x:Uid="SettingsPage_LanguageDescription" TextWrapping="Wrap"/>
              <Button x:Uid="SettingsPage_ApplyLanguage" AutomationProperties.AutomationId="ApplyLanguage" Command="{x:Bind ViewModel.ApplyLanguageCommand}"/>
            </StackPanel>
          </StackPanel>
        </Expander>
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
                <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Uid="SettingsDesign_Advanced" Style="{StaticResource CardHeading}"/>
                <TextBlock x:Uid="SettingsDesign_AdvancedDescription" Style="{StaticResource SupportingText}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="20" Padding="4">
            <StackPanel Spacing="15">
              <CheckBox x:Uid="SettingsPage_EnableService" IsChecked="{x:Bind ViewModel.EnableService, Mode=TwoWay}" Margin="0,-4,0,0"/>
              <TextBlock x:Uid="SettingsPage_EnableServiceDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,4"/>
              <CheckBox x:Uid="SettingsPage_Optimizations" IsChecked="{x:Bind ViewModel.ApplySystemOptimizations, Mode=TwoWay}"/>
              <TextBlock x:Uid="SettingsPage_OptimizationsDescription" TextWrapping="Wrap"/>
              <CheckBox x:Uid="SettingsPage_DisableAutoConfig" IsChecked="{x:Bind ViewModel.DisableAutoConfig, Mode=TwoWay}"/>
              <TextBlock x:Uid="SettingsPage_DisableAutoConfigDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,4"/>
              <CheckBox x:Uid="SettingsPage_ForceLanFallback" IsChecked="{x:Bind ViewModel.ForceLanFallback, Mode=TwoWay}"/>
              <TextBlock x:Uid="SettingsPage_ForceLanFallbackDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,4"/>
              <ComboBox x:Uid="SettingsPage_DisconnectModeHeader" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.DisconnectOptions}" SelectedItem="{x:Bind ViewModel.SelectedDisconnectMode, Mode=TwoWay}" DisplayMemberPath="Label"/>
              <TextBlock x:Uid="SettingsPage_DisconnectModeDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,4"/>
            </StackPanel>
            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,16,0,0">
              <StackPanel Spacing="12">
                <ComboBox x:Uid="SettingsPage_LogDetailHeader" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.LogLevelOptions}" SelectedItem="{x:Bind ViewModel.SelectedLogLevel, Mode=TwoWay}" DisplayMemberPath="Label"/>
                <Button x:Uid="SettingsPage_ViewLogs" Command="{x:Bind ViewModel.OpenConfigCommand}"/>
                <Button x:Uid="SettingsPage_ResetApp" Command="{x:Bind ViewModel.ResetCommand}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Visibility="{x:Bind ViewModel.ApplyHotspotVisibility, Mode=OneWay}" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Uid="SettingsDesign_SaveHint" VerticalAlignment="Center" Style="{StaticResource SupportingText}"/>
        <Button Grid.Column="1" x:Uid="SettingsPage_Save" IsEnabled="{x:Bind ViewModel.CanToggleHotspot, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" Style="{ThemeResource AccentButtonStyle}"/>
      </Grid>
    </Border>
  </Grid>
</views:ViewModelPage>
